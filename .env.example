# MyLight - Environment Configuration
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
HOST_PORT=3000          # Port exposed on the host machine
TZ=America/New_York     # Timezone for cron jobs (chore reset, etc.)

# CORS: comma-separated list of allowed origins, or * for all
# Example: http://192.168.1.100:3000,https://mylight.local
ALLOWED_ORIGINS=*

# Path to built React frontend (default: ./dist — correct for Docker)
# Set to ../dist when running the Go binary directly from go-server/ during dev
# DIST_DIR=./dist

# ─── AI Features (future) ─────────────────────────────────────────────────────
# Claude API key — enables Sidekick: smart event import, meal suggestions, etc.
# Get yours at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Calendar OAuth (future) ──────────────────────────────────────────
# Two-way sync with Google Calendar
# Create credentials at: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ─── Push Notifications (future) ─────────────────────────────────────────────
# VAPID keys for Web Push — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
